                           //Q3: factorial


#include<iostream>
using namespace std;

int fact(int p){
     
    int fact = 1;
    for(int i = 1;i<=p;i++){
     fact = fact*i;
    }
    return fact;
}


int nCr( int n,int r){

    int num = fact(n);

    int denom = fact(r)*fact(n-r);

    int ans = (num/denom);
    return ans;


}
int main(){
    int n,r;
    cin>> n >> r;

    int ans = nCr(n,r);
    cout<<ans;
    return 0;
}


