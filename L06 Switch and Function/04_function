                                 // Q5: check prime or not

#include<iostream>
using namespace std;

  // 1>prime,0>odd
bool isPrime(int n){

    for(int i = 2;i<n;i++){
        if(n%2==0){
            return 0;
        }
    }
    return 1;


}

int main(){

    int n;
    cout<<"Enter a value of n";
    cin>>n;

    if(isPrime(n)){
        cout<<"number is prime"<<endl;
    }
    else{
    cout<<"number is not prime";
    }
    return 0;

}
