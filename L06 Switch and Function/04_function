                               //Q1: power of any number

#include<iostream>
using namespace std;

int pow(int a,int b){

    int ans = 1;
     for(int i = 1;i<=b;i++){
        ans = ans*a;
     }
     return ans;

}

int main(){
    int a,b;
    cin>> a >> b;

    int ans = pow(a,b);
    cout<<ans;
    return 0;
}

