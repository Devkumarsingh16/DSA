                      // Topic: cycle detection in undirected graph using DFS
#include<iostream>
#include <bits/stdc++.h>
using namespace std;

bool detectcycle(int node,int parent,vector<int>adj[],vector<int>&visited){

    visited[node] = 1;

    for(int j = 0; j<adj[node].size();j++){

          if(parent == adj[node][j]){
            continue;
          }

          if(visited[adj[node][j]]==1){
            return 1;
          }
          if(detectcycle(adj[node][j], node,adj,visited)){
            return 1;
          }
    }
    return 0;

}

                           // Topic: cycle detection in undirected graph using BFS
#include<iostream>
#include <bits/stdc++.h>
using namespace std;


bool BFS(int vertice,vector<int>adj[],vector<int>visited){
       
  queue<pair<int,int>>q;
  visited[vertice] = 1;
  q.push(make_pair(vertice,-1));

  while(!q.empty()){
    int node = q.front().first;
    int parent = q.front().second;

  for(int j = 0; j<adj[node].size();j++){

    if(parent == adj[node][j]){
      continue;
    }

    if(visited[adj[node][j]]){
      return true;
    }

     visited[adj[node][j]] = 1;
     q.push(make_pair(visited[adj[node][j]],node));

  }
  }
    return false;

}
bool iscycle(int V,vector<int> adj[]){
     vector<int>visited(V,0);

     for(int i = 0; i< V;i++){

      if(!visited[i]){
            if(BFS(i,adj,visited)){
              return true;
            }
      }
     }
     return false;
}
