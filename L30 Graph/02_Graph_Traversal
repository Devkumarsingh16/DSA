                                     // Topic: BFS Traversal

#include<iostream>
#include <bits/stdc++.h>
using namespace std;

vector<int> BFSGraph(int v,vector<int> adj[]){
    queue<int>q;
    vector<bool> visited(v,0);
    vector<int> ans;

    q.push(0);
    visited[0] = 1;
    

    while(!q.empty()){

        int node = q.front();
        q.pop();
        ans.push_back(node);

        for(int j = 0; j<adj[node].size();j++){

            if(!visited[adj[node][j]]){
                visited[adj[node][j]] = 1;
                q.push(adj[node][j]);
            }
        }

    }
    return ans;
}
// space complexity: O(V);
//  time complexity: O(V + 2E);

