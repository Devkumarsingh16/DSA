#include<iostream>
#include <bits/stdc++.h>
using namespace std;

void DFS(int node , vector<int>adj[], vector<int> visited, vector<int> &ans){
    visited[node] = 1;
    ans.push_back(node);

    for(int j = 0 ; j<adj[node].size();j++){
        if(!visited[adj[node][j]]){
            DFS(adj[node][j],adj,visited,ans);
        }
    }
}
//space complexity: O(V);
//  time complexity: O(V + 2E);
